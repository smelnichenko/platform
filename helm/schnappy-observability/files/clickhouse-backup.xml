<clickhouse>
  <!-- the Pi store for BACKUP and RESTORE (clickhouse-backup.yaml): its keys from the environment, never in a query -->
  <named_collections>
    <backup_store>
      <url>__URL__</url>
      <access_key_id from_env="BACKUP_STORE_ACCESS_KEY"/>
      <secret_access_key from_env="BACKUP_STORE_SECRET_KEY"/>
    </backup_store>
  </named_collections>
</clickhouse>
