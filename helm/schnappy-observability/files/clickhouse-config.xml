<?xml version="1.0"?>
<clickhouse>
  <logger>
    <level>information</level>
    <console>true</console>
  </logger>
  <listen_host>0.0.0.0</listen_host>
  <http_port>8123</http_port>
  <tcp_port>9000</tcp_port>
  <interserver_http_port>9009</interserver_http_port>
  <max_connections>200</max_connections>
  <keep_alive_timeout>30</keep_alive_timeout>
  <max_concurrent_queries>50</max_concurrent_queries>
  <!-- Self-cap below cgroup so CH returns "memory limit exceeded" per
       query instead of getting OOMKilled by the kernel. -->
  <max_server_memory_usage_to_ram_ratio>0.85</max_server_memory_usage_to_ram_ratio>
  <users_config>users.xml</users_config>
  <default_profile>default</default_profile>
  <default_database>logs</default_database>
  <timezone>UTC</timezone>
  <path>/var/lib/clickhouse/</path>
  <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
  <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>
  <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>
  <!-- ClickHouse's own logs kept 14 days: with no TTL they grew without end (52 GB on ten, 2026-10-16, beside 2.5 GB
       of pod logs) - every backup copied them and a new release's first start loaded them. A changed definition makes
       ClickHouse rename the old table (query_log_0, ...) at its next start and begin a new one: the renamed ones keep
       their rows until dropped. -->
  <query_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></query_log>
  <part_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></part_log>
  <trace_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></trace_log>
  <metric_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></metric_log>
  <asynchronous_metric_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></asynchronous_metric_log>
  <processors_profile_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></processors_profile_log>
  <text_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></text_log>
  <error_log><ttl>event_date + INTERVAL 14 DAY DELETE</ttl></error_log>
  <prometheus>
    <endpoint>/metrics</endpoint>
    <port>9363</port>
    <metrics>true</metrics>
    <events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics>
  </prometheus>
</clickhouse>
